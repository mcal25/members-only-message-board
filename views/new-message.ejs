<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Message</title>
</head>
<body>
    <h1>New Message</h1>
    <form action="/messages/new-message" method="POST">
        <label for="messagetitle">Title:</label>
        <input type="text" name="messagetitle" placeholder="Glorious Message">
        <label for="messagetext">Your message:</label>
        <input type="text" name="messagetext" placeholder="I like turtles!">
        <button type="submit">Submit</button>
    </form>
    <br>
    <a href="/"><button>Home</button></a>
    <a href="/messages"><button>Back</button></a>
</body>
</html>